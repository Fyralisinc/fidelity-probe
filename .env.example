# Ingestion / fidelity client configuration.
#
# THE ONLY BEHAVIORAL KNOB PER PROVIDER IS THE BASE URL (+ Discord gateway URL).
# Each base URL defaults to the real production host, so leaving it unset targets
# the real service. Point at a local mock purely by setting the base URL. Tokens
# and secrets are credentials, supplied as usual — no mock-specific switches exist.

# ---------------- Slack ----------------
# API base for slack_sdk WebClient (must end with a slash). Default: https://slack.com/api/
SLACK_BASE_URL=http://localhost:7001/api/
# OAuth consent URL. Defaults to <origin of SLACK_BASE_URL>/oauth/v2/authorize
# SLACK_AUTHORIZE_URL=http://localhost:7001/oauth/v2/authorize

# OAuth app credentials (for the real authorization-code flow):
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:8080/slack/oauth/callback
# SLACK_SCOPES=channels:read,channels:history,...    # sensible default if unset

# Skip interactive OAuth by supplying a code, or a pre-issued bot token:
# SLACK_OAUTH_CODE=
SLACK_BOT_TOKEN=

# Events API signature verification:
SLACK_SIGNING_SECRET=

# ---------------- GitHub ----------------
# API base for PyGithub. GITHUB_BASE_URL is PyGithub's constructor param name;
# GITHUB_API_BASE_URL is accepted as an alias (mirrors GHE's /api/v3 knob).
# Default: https://api.github.com
GITHUB_BASE_URL=http://localhost:7003
GITHUB_APP_ID=274100
# Supply the App private key as a real GitHub App key would be: a .pem file path,
# or the PEM contents inline. The client mints the RS256 App JWT itself.
GITHUB_PRIVATE_KEY_PATH=
# GITHUB_PRIVATE_KEY=        # PEM contents inline (alternative to the path)
GITHUB_INSTALLATION_ID=21341112
# Webhook HMAC secret (X-Hub-Signature-256) for the live listener:
GITHUB_WEBHOOK_SECRET=

# ---------------- Discord ----------------
# discord.py has no base_url param, so BOTH transports are redirected to the target:
# REST base (DISCORD_API_BASE_URL, alias DISCORD_API_BASE) and gateway base
# (DISCORD_GATEWAY_URL). Defaults point at the real Discord. The ?v=&encoding= query on
# the gateway URL is set by the library, so a bare ws base is fine here.
DISCORD_API_BASE_URL=http://localhost:7002/api/v10
DISCORD_GATEWAY_URL=ws://localhost:7002/gateway
DISCORD_BOT_TOKEN=

# ---------------- Google Workspace (Gmail + Calendar) ----------------
# Service account + domain-wide delegation. The SA key is supplied as a real key would
# be (PEM env or file); if unset, an ephemeral key is used (works only against a target
# that doesn't verify the assertion signature). Base URLs default to the real Google
# hosts; point at the mock by setting them.
GOOGLE_SERVICE_ACCOUNT_EMAIL=gmail-push@spammer-org-ingest.iam.gserviceaccount.com
GOOGLE_CUSTOMER_ID=
GOOGLE_DOMAIN=spammer-org.test
# GOOGLE_ADMIN_SUBJECT=admin@spammer-org.test   # directory impersonation subject (default admin@<domain>)
# GOOGLE_PRIVATE_KEY_PATH=    # or GOOGLE_PRIVATE_KEY=<PEM>; omit to use an ephemeral key
GMAIL_API_BASE_URL=http://localhost:7004/gmail/v1
GMAIL_TOKEN_URL=http://localhost:7004/token
GMAIL_DIRECTORY_BASE_URL=http://localhost:7004/admin/directory/v1
GMAIL_JWKS_URL=http://localhost:7004/jwks
CALENDAR_API_BASE_URL=http://localhost:7005/calendar/v3
CALENDAR_TOKEN_URL=http://localhost:7005/token
# Google Drive reuses the same SA/DWD auth (scope drive.readonly). Set the mock base URL:
GOOGLE_DRIVE_API_BASE_URL=
# GOOGLE_DRIVE_TOKEN_URL=    # defaults to GMAIL_TOKEN_URL

# ---------------- Jira (Atlassian Cloud) ----------------
# Per-install site base URL (no global host). JIRA_API_BASE_URL overrides it (point at
# the mock); otherwise JIRA_BASE_URL is the site, e.g. https://acme.atlassian.net.
# Auth is HTTP Basic = base64(account_email:api_token).
JIRA_API_BASE_URL=
JIRA_ACCOUNT_EMAIL=
JIRA_API_TOKEN=

# ---------------- Notion ----------------
# Single internal integration. Notion-Version is pinned.
NOTION_API_BASE_URL=http://localhost:7006
NOTION_TOKEN=
# NOTION_VERSION=2022-06-28

# ---------------- Webhook listener bind ----------------
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080
