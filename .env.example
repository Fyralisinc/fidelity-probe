# Ingestion / fidelity client configuration.
#
# THE ONLY BEHAVIORAL KNOB PER PROVIDER IS THE BASE URL (+ Discord gateway URL).
# Each base URL defaults to the real production host, so leaving it unset targets
# the real service. Point at a local mock purely by setting the base URL. Tokens
# and secrets are credentials, supplied as usual — no mock-specific switches exist.

# ---------------- Slack ----------------
# API base for slack_sdk WebClient (must end with a slash). Default: https://slack.com/api/
SLACK_BASE_URL=http://localhost:7001/api/
# OAuth consent URL. Defaults to <origin of SLACK_BASE_URL>/oauth/v2/authorize
# SLACK_AUTHORIZE_URL=http://localhost:7001/oauth/v2/authorize

# OAuth app credentials (for the real authorization-code flow):
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:8080/slack/oauth/callback
# SLACK_SCOPES=channels:read,channels:history,...    # sensible default if unset

# Skip interactive OAuth by supplying a code, or a pre-issued bot token:
# SLACK_OAUTH_CODE=
SLACK_BOT_TOKEN=

# Events API signature verification:
SLACK_SIGNING_SECRET=

# ---------------- GitHub (slice 2) ----------------
GITHUB_BASE_URL=http://localhost:7003
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=
# GITHUB_PRIVATE_KEY=        # PEM contents inline (alternative to the path)
GITHUB_INSTALLATION_ID=
GITHUB_WEBHOOK_SECRET=

# ---------------- Discord (slice 3) ----------------
DISCORD_API_BASE=http://localhost:7002/api/v10
DISCORD_GATEWAY_URL=ws://localhost:7002/gateway
DISCORD_BOT_TOKEN=

# ---------------- Webhook listener bind ----------------
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080
